{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#BBC4B9",
          "style": "plain",
          "template": "{{ .HostName }}",
          "type": "session"
        },
        {
          "foreground": "#BBC4B9",
          "options": {
            "home_enabled": true
          },
          "style": "plain",
          "template": "{{ if .Venv }} ➜ \ue715 ({{ .Venv }}) {{ end }}",
          "type": "python"
        },
        {
          "foreground": "cyan",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": " <#ffffff>in</> {{ .Path }} ",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "foreground": "#BBC4B9",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E06C75{{ end }}"
          ],
          "style": "plain",
          "template": " x{{ reason .Code }}",
          "type": "status"
        },
        {
          "foreground": "#BBC4B9",
          "options": {
            "always_enabled": false,
            "style": "roundrock",
            "threshold": 2000
          },
          "style": "diamond",
          "template": " {{ .FormattedMs }} ",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#BBC4B9",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#E5C07B{{ end }}"
          ],
          "options": {
            "branch_gone_icon": "\ueab8",
            "branch_icon": "\uf418 ",
            "branch_identical_icon": "\uf444",
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": false
          },
          "style": "plain",
          "template": "{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#BBC4B9",
          "style": "plain",
          "template": "\u0021",
          "type": "root"
        },
        {
          "foreground": "#BBC4B9",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E06C75{{ end }}"
          ],
          "style": "plain",
          "template": "@",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
